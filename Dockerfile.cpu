# ==============================================================================
# Stage 1: Build Rust binary on Ubuntu 22.04 (guarantees GLIBC 2.35 compatibility)
# ==============================================================================
FROM ubuntu:22.04 AS builder

WORKDIR /usr/src/app

ENV DEBIAN_FRONTEND=noninteractive

# Native C/C++ compilation toolchain for ring and native dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    cmake \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Rust manifest and lockfile
COPY Cargo.toml Cargo.lock ./

# Source code
COPY src/ ./src/

# Release compilation
RUN cargo build --release --bin runpod-pipeline

# ==============================================================================
# Stage 2: Lightweight CPU Runtime (RunPod Web Studio & Cloud AI Orchestrator)
# ==============================================================================
FROM ubuntu:22.04

LABEL maintainer="NikOol172"
LABEL description="RunPod Studio (CPU Version) - Web Interface & Cloud AI Orchestrator"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PORT=3000

WORKDIR /app

# System dependencies: Python 3.10, FFmpeg, audio libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    ffmpeg \
    libsndfile1 \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

# Install PyTorch CPU wheels followed by CPU requirements
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

COPY requirements-cpu.txt /app/
RUN pip install --no-cache-dir -r requirements-cpu.txt

# Copy compiled Rust binary
COPY --from=builder /usr/src/app/target/release/runpod-pipeline /app/runpod-pipeline

# Copy web assets and source scripts
COPY web/ /app/web/
COPY src/ /app/src/
COPY docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh /app/runpod-pipeline

EXPOSE 3000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
